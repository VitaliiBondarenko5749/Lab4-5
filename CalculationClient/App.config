<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>
		<client>
			<endpoint
			  name="CalculationServiceEndpoint"
			  address="http://localhost:9999/CalculationService"
			  binding="basicHttpBinding"
			  contract="CalculationInterfaces.ICalculationService" />
		</client>
	</system.serviceModel>
</configuration>